# Debug settings
DEBUG=mediasoup-demo-server:INFO* *WARN* *ERROR*

# Domain settings
DOMAIN=1-psychologist.ru

# Protoo WebSocket server settings
PROTOO_LISTEN_PORT=4443

# HTTPS certificate paths (comment out or remove these as Nginx handles SSL)
# HTTPS_CERT_FULLCHAIN=certs/fullchain.pem
# HTTPS_CERT_PRIVKEY=certs/privkey.pem

# Mediasoup settings
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=176.124.210.198
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# Valgrind settings (usually not needed for local development)
MEDIASOUP_USE_VALGRIND=false
MEDIASOUP_VALGRIND_OPTIONS=--leak-check=full --track-fds=yes --log-file=/storage/mediasoup_valgrind_%p.log
INTERACTIVE=true